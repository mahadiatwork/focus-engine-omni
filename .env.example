# WhatsApp Cloud API / Chat SDK
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BOT_USERNAME=mahadi-agent

# OpenRouter is OpenAI-compatible and is accessed only on the server.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Firebase Admin SDK (server-only; never expose these in browser code)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Must equal the only WhatsApp number allowed to use this private bot.
OWNER_WHATSAPP_ID=

# Optional protection for the reminder delivery endpoint.
CRON_SECRET=

# Keep false until proactive messaging and billing are explicitly verified.
ENABLE_PROACTIVE_MESSAGES=false
